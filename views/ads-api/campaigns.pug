extends layout.pug

block content
  style.
    .campaign-modal[hidden] {
      display: none;
    }
    .campaign-modal {
      position: fixed;
      inset: 0;
      z-index: 1050;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      background: rgba(0, 0, 0, 0.5);
    }
    .campaign-modal-dialog {
      width: min(100%, 760px);
      max-height: 90vh;
      overflow: auto;
      background: #fff;
      border-radius: 0.5rem;
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.25);
    }
    .campaign-modal-header,
    .campaign-modal-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem;
      border-bottom: 1px solid #dee2e6;
    }
    .campaign-modal-footer {
      justify-content: flex-end;
      border-top: 1px solid #dee2e6;
      border-bottom: 0;
    }
    .campaign-modal-header h2 {
      margin: 0;
      font-size: 1.25rem;
    }
    .campaign-modal-body {
      padding: 1rem;
    }
    .campaign-modal-body table {
      width: 100%;
      margin: 0;
      border-collapse: collapse;
    }
    .campaign-modal-body th,
    .campaign-modal-body td {
      padding: 0.5rem;
      border-bottom: 1px solid #dee2e6;
      text-align: left;
      vertical-align: top;
    }
    .campaign-modal-body td {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .campaign-modal-close {
      border: 0;
      background: transparent;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
    }
  .campaign-container
    .filters
      h2 筛选条件
      form#filterForm
        .form-row
          .form-group
            label(for="countryFilter") 国家:
            select#countryFilter(name="country")
              option(value="") 全部国家
              option(value="US") 美国
              option(value="CA") 加拿大
              option(value="UK") 英国
              option(value="AE") 阿联酋
              option(value="SA") 沙特
          
          .form-group
            label(for="statusFilter") 状态:
            select#statusFilter(name="status")
              option(value="") 全部
              option(value="enabled" selected) 启用中
              option(value="paused") 已暂停
              option(value="archived") 已归档
          
          .form-group
            label(for="nameFilter") 名称包含:
            input#nameFilter(type="text", name="name", placeholder="输入活动名称")

          .form-group
            label(for="feePeriodFilter") 费用计算周期:
            select#feePeriodFilter(name="feePeriod")
              option(value="day" selected) 按日
              option(value="week") 按周
              option(value="month") 按月
        
        .form-actions
          button.btn-secondary#resetBtn(type="button") 重置
    
    .campaign-stats
      .stat-card
        h3 总活动数
        p#totalCampaigns 0
      .stat-card
        h3 总预算
        p#totalBudget $0.00
      .stat-card
        h3 总预算使用率
        p#budgetUsage 0.00%
      .stat-card
        h3 平均CTR
        p#avgCtr 0.00%
    
    .campaign-list
      .table-responsive
        table
          thead
            tr
              th ID
              th 名称
              th 国家
              th 状态
              th 预算
              th 费用计算周期
              th 
                span.tooltip 预算使用率
                  span.tooltiptext 已花费/总预算
              th 操作
          tbody#campaignTableBody
            tr
              td(colspan="8") 正在加载数据...
      
      .pagination-controls
        .pagination-info
          span#pageInfo 显示 0-0 条，共 0 条
        .pagination-buttons
          button#prevPage(disabled) 上一页
          button#nextPage(disabled) 下一页

  #campaignDetailsModal.campaign-modal(hidden role="dialog" aria-modal="true" aria-labelledby="campaignDetailsTitle")
    .campaign-modal-dialog
      .campaign-modal-header
        h2#campaignDetailsTitle 广告活动详情
        button.campaign-modal-close#closeCampaignDetails(type="button" aria-label="关闭") &times;
      .campaign-modal-body
        section.campaign-orders
          h3 归因销售额汇总
          p
            | 查询周期：
            span#campaignSalesPeriod
          p.text-muted 销售额按广告归因口径统计，归因窗口为 14 天。
          p#campaignSalesStatus(role="status" aria-live="polite") 尚未查询
          button#continueCampaignSales.btn-secondary(type="button" hidden) 继续查询
        hr
        h3 活动信息
        table
          tbody#campaignDetailsBody
      .campaign-modal-footer
        button.btn-secondary#closeCampaignDetailsFooter(type="button") 关闭

block scripts
  script(src="https://cdn.jsdelivr.net/npm/lodash@4.17.21/lodash.min.js")
  script(src="/compaigns.js")