#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('jadehome:server');
var https = require('https');
var fs = require('fs');

console.log('Env: ' + process.env);
console.log('Private key: ' + process.env.PRIVATE_KEY);
console.log('Certificate: ' + process.env.CERTIFICATE);

var privateKeyPath = process.env.PRIVATE_KEY;
var certificatePath = process.env.CERTIFICATE;

if (!privateKeyPath || !certificatePath) {
  console.error('Missing TLS settings: PRIVATE_KEY and CERTIFICATE must be defined in .env');
  process.exit(1);
}

var privateKey;
var certificate;

try {
  privateKey = fs.readFileSync(privateKeyPath);
  certificate = fs.readFileSync(certificatePath);
  console.log('TLS certificate files loaded successfully.');
} catch (err) {
  console.error('Failed to read TLS certificate files. Please check PRIVATE_KEY and CERTIFICATE in .env.');
  console.error(err.message);
  process.exit(1);
}

var credentials = {key: privateKey, cert: certificate};
/**
 * Get port from environment and store in Express.
 */

var httpsport = normalizePort(process.env.PORT || '3000');
app.set('httpsport', httpsport);

/**
 * Create HTTP server.
 */
var httpsserver = https.createServer(credentials, app);

console.log('Starting HTTPS server on port ' + httpsport + '...');

/**
 * Listen on provided port, on all network interfaces.
 */
httpsserver.listen(httpsport);
httpsserver.on('error', onError);
httpsserver.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof httpsport === 'string'
    ? 'Pipe ' + httpsport
    : 'Port ' + httpsport;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = httpsserver.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  console.log('HTTPS server listening on ' + bind);
  debug('Listening on ' + bind);
}
